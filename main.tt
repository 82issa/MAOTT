#ACTION {^%11H %12V %13X %14% %15C [**%18:%19**] [**%20:%21**] Mem:%22 T:%16 Exits:%17>}  { processPrompt %22 0 %11 %12 %13 %14 %15 %16 %17; processWatch %18 %19; processOpponent %20 %21 }
#ACTION {^%11H %12V %13X %14% %15C [%18:%19] [%20:%21] Mem:%22 T:%16 Exits:%17>}          { processPrompt %22 1 %11 %12 %13 %14 %15 %16 %17; processTank %18 %19; processOpponent %20 %21 }
#ACTION {^%11H %12V %13X %14% %15C [**%18:%19**] Mem:%22 T:%16 Exits:%17>}                { processPrompt %22 0 %11 %12 %13 %14 %15 %16 %17; processWatch %18 %19 }
#ACTION {^%11H %12V %13X %14% %15C [%18:%19] Mem:%22 T:%16 Exits:%17>}                    { processPrompt %22 1 %11 %12 %13 %14 %15 %16 %17 }
#ACTION {^%11H %12V %13X %14% %15C Mem:%22 T:%16 Exits:%17>}                              { processPrompt %22 0 %11 %12 %13 %14 %15 %16 %17 }

#ACTION {^%11H %12V %13X %14% %15C [**%18:%19**] [**%20:%21**] T:%16 Exits:%17>}  { processPrompt 0 0 %11 %12 %13 %14 %15 %16 %17; processWatch %18 %19 ; processOpponent %20 %21  }
#ACTION {^%11H %12V %13X %14% %15C [%18:%19] [%20:%21] T:%16 Exits:%17>}          { processPrompt 0 1 %11 %12 %13 %14 %15 %16 %17; processTank %18 %19 ; processOpponent %20 %21  }
#ACTION {^%11H %12V %13X %14% %15C [**%18:%19**] T:%16 Exits:%17>}                { processPrompt 0 0 %11 %12 %13 %14 %15 %16 %17; processWatch %18 %19  }
#ACTION {^%11H %12V %13X %14% %15C [%18:%19] T:%16 Exits:%17>}                    { processPrompt 0 1 %11 %12 %13 %14 %15 %16 %17 }
#ACTION {^%11H %12V %13X %14% %15C T:%16 Exits:%17>}                              { processPrompt 0 0 %11 %12 %13 %14 %15 %16 %17 }

#ALIAS {processPrompt} {
  #VARIABLE {character[mem]}              { %1};
  #VARIABLE {character[isFighting]}       { %2};
  #VARIABLE {character[HP]}               { %3};
  #VARIABLE {character[moves]}            { %4};
  #VARIABLE {character[tillNextLevel]}    { %5};
  #VARIABLE {character[percentRank]}      { %6};
  #VARIABLE {character[coins]}            { %7};
  #VARIABLE {character[tick]}             { %8};
  #VARIABLE {character[exits]}            { %9}
}

#ALIAS {processTank}{
  #VARIABLE {character[isTanking]}      {%1} ;
  #VARIABLE {character[tankCondition]}  {%2}
}

#ALIAS {processWatch}{
  #VARIABLE {character[isWatching]}     {%1};
  #VARIABLE {character[watchCondition]} {%2}
}

#ALIAS {processOpponent}{
  #VARIABLE {character[target]}           {%1} ;
  #VARIABLE {character[targetCondition]}  {%2}
}

#ACTION {You are %1 the %2 %3, a level %4 %5.} {
    #VARIABLE {character[name]} {%1};
    #VARIABLE {character[sex]} {%2};
    #VARIABLE {character[race]} {%3};
    #VARIABLE {character[level]} {%4};
    #VARIABLE {character[class]} {%5}
}

#ACTION {You are rank %1.} {
    #VARIABLE {character[rank]} {%1}
}

#ACTION {You are %1 years old.} {
    #VARIABLE {character[age]} {%1}
}

#ACTION {You have %1(%2) hit and %3(%4) movement points.} {
    #VARIABLE {character[hp]} {%1};
    #VARIABLE {character[hp_max]} {%2};
    #VARIABLE {character[moves]} {%3};
    #VARIABLE {character[moves_max]} {%4}
}

#ALIAS {autoAssistFightCheck} { #IF {$character[auto][assist] == 1 && $character[isFighting] == 0}{ assist; #VARIABLE {character[isFighting]} {1} } }

#ALIAS {protect.add}    {#ACTION {%1 {smites|claws|stabs|cleaves|pierces|slashes|misses|hits|bruises|barely|massacres|annihilates|obliterates}} { autoAssistFightCheck}; #VARIABLE {character[auto][assist]} {1};#SHOWME <fac>added %1 }
#ALIAS {protect.remove} {#UNACTION {%1 {smites|claws|stabs|cleaves|pierces|slashes|misses|hits|bruises|barely|massacres|annihilates|obliterates}};#SHOWME <fac>removed %1 }

#FUNCTION {checks}{
  #IF { $character[cooldown][main] == 0 } {#NOP} {#RETURN 0};
  #IF { $character[cooldown][%1] == 0 }   {#NOP} {#RETURN 0};
  #IF { $character[isFighting] == %2 }    {#NOP} {#RETURN 0};
  #IF { $character[ready][%1] == 1 }      {#NOP} {#RETURN 0};
  #IF { $character[auto][%1] == 1 }       {#NOP} {#RETURN 0};
  #RETURN 1
  }

#ALIAS {doStuff}{
  #VARIABLE {character[ready][%1]}        {%2};
  #VARIABLE {character[cooldown][%1]}     {%3};
  #IF { $character[cooldown][main] < %4 } { #VARIABLE {character[cooldown][main]} {%3} } {#NOP}
}

#ALIAS {cooldownGo}{
  #FOREACH {$character[cooldown]}{element}{ #IF { $character[cooldown][$element] >= 1 } {#MATH {character[cooldown][$element]} {$character[cooldown][$element] - 1}} {#NOP} } }

#ALIAS {auto}      { #VARIABLE {character[auto][%1]} {%2} }
#ALIAS {ready}     { #VARIABLE {character[ready][%1]} {%2} }
#ALIAS {cooldown}  { #VARIABLE {character[cooldown][%1]} {%2} }
#ALIAS {target}    { #VARIABLE {character[target][%1]} {%2} }
#ALIAS {dsm}   {#SHOWME <fac>%0}

#00000000000000000000000000000000
#0 Food and drink related stuff 0
#00000000000000000000000000000000
#VARIABLE {character[auto][eat]} {1}
#VARIABLE {character[auto][drink]} {1}
#VARIABLE {food}    {bread}
#VARIABLE {drink}   {water}
#ACTION {You are hungry}                {#IF {$character[auto][eat] == 1}           {eat $food}}
#ACTION {You are thirsty}               {#IF {$character[auto][drink] == 1}         {drink $drink}}
#ALIAS {ef}     {eat $food}
#ALIAS {dw}     {drink $drink}
#ALIAS {ead}    {eat $food;drink $drink}
#ALIAS {fa}     {drink %1;drink %1;fill all %1}
#ALIAS {ff}     {drink fountain;drink fountain;fill all fountain}

#000000000000
#0 Footwork 0
#000000000000
#ACTION {probably stand up}                     {#IF {$character[isFighting] == 1}{stand}}
#ACTION {You are sent sprawling}                {#IF {$character[isFighting] == 1}{stand}}
#ACTION {You start using the %1.}               {#VARIABLE character[wep1] %1}
#ACTION {You start using the %1 as a secondary} {#VARIABLE character[wep2] %1}
#ACTION {disarms your weapon}   {get $character[wep1];wield $character[wep1];get character[$wep2]; wield $character[wep2] left}
#ACTION {used in primary hand> %2$}    {#VARIABLE character[wep1] %2}
#ACTION {used in secondary hand> %2$}  {#VARIABLE character[wep2] %2}

#00000000000
#0 Looting 0
#00000000000
#ALIAS {ga}     {get all}
#ALIAS {gc}     {get coins}
#ALIAS {gp}     {get pile}
#ALIAS {gac}    {get all corpse}
#ALIAS {gcc}    {get all.coins corpse}
#ALIAS {gpc}    {get pile corpse}
#ALIAS {lp}     {#LOOP 1 %1 cnt {get all $cnt.corpse}}
#ALIAS {lpc}    {#LOOP 1 %1 cnt {get all.coins $cnt.corpse}}

