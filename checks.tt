#TICKER {autoChecker} { autoRescueCheck; autoTankCheck; @autoBattleCheck{}; @autoGoreCheck{}; @autoChargeCheck{}; @autoAssailCheck{}; autoSharpenCheck; autoMendCheck; @cooldownGo{} }{1}
